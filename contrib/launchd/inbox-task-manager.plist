<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  itm's daemon as a launchd agent (macOS without the home-manager module).
    1. Replace /Users/YOU with your home folder and check the itm path
       (`command -v itm`).
    2. cp inbox-task-manager.plist ~/Library/LaunchAgents/
    3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/inbox-task-manager.plist
  launchd does not read your shell profile: herdr must be on the PATH below,
  and XDG_CONFIG_HOME / XDG_STATE_HOME / XDG_DATA_HOME must match your shell's
  when you set them (add them under EnvironmentVariables).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>inbox-task-manager</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.local/bin/itm</string>
    <string>daemon</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/inbox-task-manager.log</string>
</dict>
</plist>
